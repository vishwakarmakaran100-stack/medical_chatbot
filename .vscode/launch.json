{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Medical Chatbot",
            "type": "python",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "medibot_enhanced.py",
                "--server.headless=true",
                "--server.port=8501"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe"
        }
    ]
}
